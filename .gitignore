.ipynb_checkpoints/
*.ipynb_checkpoints

# --- IDEs ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Modelos pesados (se pueden regenerar) ---
# outputs/models/*.pkl   # Comentado: los dejamos en el repo (son pequeños)

# --- Logs y temporales ---
*.log
*.tmp
*.bak

# --- Archivos del sistema ---
desktop.ini
ehthumbs.db
